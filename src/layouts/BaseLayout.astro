---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { localPath, type Locale } from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  canonicalPath?: string;
  alternatePath?: string;
  languagePath?: string;
  noindex?: boolean;
  article?: { publishedTime: Date; modifiedTime?: Date };
}

const {
  title = "Gonçalo Raposo — Software Engineer",
  description = "Software engineer working on backend systems, with a background in aerospace engineering and artificial intelligence research.",
  locale = "en",
  canonicalPath = "/",
  alternatePath,
  languagePath = alternatePath,
  noindex = false,
  article,
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const englishPath =
  locale === "en" ? canonicalPath : (alternatePath ?? canonicalPath.replace(/^\/pt/, ""));
const portuguesePath =
  locale === "pt-PT" ? canonicalPath : (alternatePath ?? `/pt${canonicalPath}`);
const ogImage = new URL(`/social${canonicalPath}og.png`, Astro.site);
const isPreview = import.meta.env.BASE_URL !== "/";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let saved;
        try {
          saved = localStorage.getItem("theme");
        } catch {
          /* Storage can be disabled. */
        }
        const dark =
          saved === "dark" ||
          (saved !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || isPreview) && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {
      !noindex && (
        <>
          {(locale === "en" || alternatePath) && (
            <link rel="alternate" hreflang="en" href={new URL(englishPath, Astro.site)} />
          )}
          {(locale === "pt-PT" || alternatePath) && (
            <link rel="alternate" hreflang="pt-PT" href={new URL(portuguesePath, Astro.site)} />
          )}
          <link
            rel="alternate"
            hreflang="x-default"
            href={
              new URL(
                locale === "pt-PT" && !alternatePath ? canonicalPath : englishPath,
                Astro.site,
              )
            }
          />
        </>
      )
    }
    <link rel="icon" href={localPath("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="Gonçalo Raposo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={locale === "pt-PT" ? "pt_PT" : "en_GB"} />
    {
      article && (
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
      )
    }
    {
      article?.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Gonçalo Raposo",
        url: "https://www.goncaloraposo.com",
        jobTitle: "Software Engineer",
        sameAs: [
          "https://github.com/gonced8",
          "https://www.linkedin.com/in/goncalo-raposo/",
          "https://scholar.google.com/citations?user=HBN5h6EAAAAJ",
          "https://orcid.org/0000-0001-7806-6526",
        ],
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main"
      >{locale === "pt-PT" ? "Saltar para o conteúdo" : "Skip to content"}</a
    >
    <Header locale={locale} alternatePath={languagePath} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
