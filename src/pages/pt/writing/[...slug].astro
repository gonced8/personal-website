---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection(
    "writing",
    ({ data }) => data.locale === "pt-PT" && !data.draft,
  );
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^pt\//, "").replace(/\.md$/, "") },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const sibling = (
  await getCollection("writing", ({ data }) => data.locale === "en" && !data.draft)
).find(
  (candidate) =>
    candidate.data.translationKey && candidate.data.translationKey === entry.data.translationKey,
);
const alternatePath = sibling
  ? `/writing/${sibling.id.replace(/^en\//, "").replace(/\.md$/, "")}/`
  : undefined;
const canonicalPath = `/pt/writing/${entry.id.replace(/^pt\//, "").replace(/\.md$/, "")}/`;
---

<ArticleLayout
  entry={entry}
  locale="pt-PT"
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}><Content /></ArticleLayout
>
