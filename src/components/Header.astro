---
import { localPath, otherLocalePath, type Locale } from "../i18n/utils";
interface Props {
  locale: Locale;
  alternatePath?: string;
}
const { locale, alternatePath } = Astro.props;
const pt = locale === "pt-PT";
const home = pt ? "/pt/" : "/";
const nav = pt
  ? [
      ["Sobre", "#about"],
      ["Projetos", "/pt/projects/"],
      ["Investigação", "#research"],
      ["Escrita", "/pt/writing/"],
      ["Contacto", "#contact"],
    ]
  : [
      ["About", "#about"],
      ["Projects", "/projects/"],
      ["Research", "#research"],
      ["Writing", "/writing/"],
      ["Contact", "#contact"],
    ];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(basePath, "") || "/";
const languageHref = alternatePath ?? otherLocalePath(currentPath, locale);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={localPath(home)}>Gonçalo Raposo</a>
    <nav aria-label={pt ? "Navegação principal" : "Primary navigation"}>
      {
        nav.map(([label, href]) => (
          <a href={localPath(href.startsWith("#") ? `${home}${href}` : href)}>{label}</a>
        ))
      }
    </nav>
    <div class="header-controls">
      <a
        class="language-toggle"
        hreflang={pt ? "en" : "pt-PT"}
        lang={pt ? "en" : "pt-PT"}
        href={localPath(languageHref)}>{pt ? "EN" : "PT"}</a
      >
      <button
        class="theme-toggle"
        type="button"
        aria-label={pt ? "Mudar tema" : "Change theme"}
        title={pt ? "Mudar tema" : "Change theme"}
      >
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </div>
</header>
<script>
  document.querySelector<HTMLButtonElement>(".theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>
