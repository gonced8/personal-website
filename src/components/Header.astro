---
import { localPath, otherLocalePath, type Locale } from "../i18n/utils";
interface Props {
  locale: Locale;
  alternatePath?: string;
}
const { locale, alternatePath } = Astro.props;
const pt = locale === "pt-PT";
const home = pt ? "/pt/" : "/";
const nav = pt
  ? [
      ["Sobre", "#about"],
      ["Projetos", "/pt/projects/"],
      ["Investigação", "#research"],
      ["Escrita", "/pt/writing/"],
      ["Contacto", "#contact"],
    ]
  : [
      ["About", "#about"],
      ["Projects", "/projects/"],
      ["Research", "#research"],
      ["Writing", "/writing/"],
      ["Contact", "#contact"],
    ];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(basePath, "") || "/";
const languageHref = alternatePath ?? otherLocalePath(currentPath, locale);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={localPath(home)}>Gonçalo Raposo</a>
    <nav aria-label={pt ? "Navegação principal" : "Primary navigation"}>
      {
        nav.map(([label, href]) => (
          <a
            aria-current={currentPath === href ? "page" : undefined}
            href={localPath(href.startsWith("#") ? `${home}${href}` : href)}
          >
            {label}
          </a>
        ))
      }
    </nav>
    <div class="header-controls">
      <a
        class="language-toggle"
        hreflang={pt ? "en" : "pt-PT"}
        lang={pt ? "en" : "pt-PT"}
        href={localPath(languageHref)}>{pt ? "EN" : "PT"}</a
      >
      <button
        class="theme-toggle"
        hidden
        type="button"
        aria-label={pt ? "Mudar tema" : "Change theme"}
        title={pt ? "Mudar tema" : "Change theme"}
      >
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const system = matchMedia("(prefers-color-scheme: dark)");
  let manual = false;
  try {
    manual = ["light", "dark"].includes(localStorage.getItem("theme") ?? "");
  } catch {
    /* Optional storage. */
  }
  function update() {
    const dark = document.documentElement.dataset.theme === "dark";
    const pt = document.documentElement.lang === "pt-PT";
    button?.setAttribute(
      "aria-label",
      dark
        ? pt
          ? "Usar tema claro"
          : "Use light theme"
        : pt
          ? "Usar tema escuro"
          : "Use dark theme",
    );
    button?.setAttribute("title", button.getAttribute("aria-label") ?? "");
    if (button) button.innerHTML = `<span aria-hidden="true">${dark ? "☀" : "☾"}</span>`;
  }
  if (button) {
    button.hidden = false;
    update();
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      manual = true;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* Theme still works for this page. */
      }
      update();
    });
    system.addEventListener("change", ({ matches }) => {
      if (!manual) {
        document.documentElement.dataset.theme = matches ? "dark" : "light";
        update();
      }
    });
  }
</script>
