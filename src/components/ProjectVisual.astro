---
import type { Locale } from "../i18n/utils";
const { kind, locale } = Astro.props as { kind: string; locale: Locale };
const pt = locale === "pt-PT";
const labels =
  kind === "xcos-mcp"
    ? ["AI agent", "MCP", "Scilab / Xcos"]
    : [
        pt ? "Rede neuronal" : "Neural network",
        pt ? "Precisão mista" : "Mixed precision",
        "PositNN",
      ];
---

<div class="project-visual diagram">
  {
    kind === "accessibility" ? (
      <div class="demo-card">
        <>
          <p class="demo-kicker">
            {pt ? "Demonstração · dados fictícios" : "Illustration · fictional data"}
          </p>
          <span class="demo-symbol" aria-hidden="true">
            ∞
          </span>
          <h4>{pt ? "Tenho autismo" : "I am autistic"}</h4>
          <p>
            {pt
              ? "Posso precisar de mais tempo para comunicar. Obrigado pela compreensão."
              : "I may need more time to communicate. Thank you for your understanding."}
          </p>
          <span>{pt ? "Cartão de apoio à comunicação" : "Communication support card"}</span>
        </>
      </div>
    ) : kind === "orbit-radar" ? (
      <svg
        viewBox="0 0 600 400"
        role="img"
        aria-label={
          pt
            ? "Diagrama ilustrativo de uma órbita em torno da Terra"
            : "Illustrative diagram of an orbit around Earth"
        }
      >
        <>
          <circle
            cx="300"
            cy="192"
            r="95"
            fill="var(--surface)"
            stroke="var(--accent)"
            stroke-width="2"
          />
          <ellipse cx="300" cy="192" rx="40" ry="95" fill="none" stroke="var(--line)" />
          <ellipse cx="300" cy="192" rx="95" ry="35" fill="none" stroke="var(--line)" />
          <path d="M205 192h190M300 97v190" stroke="var(--line)" />
          <ellipse
            cx="300"
            cy="192"
            rx="185"
            ry="65"
            transform="rotate(-30 300 192)"
            fill="none"
            stroke="var(--accent)"
            stroke-width="2"
          />
          <circle cx="461" cy="99" r="7" fill="var(--accent)" />
          <text x="300" y="345" text-anchor="middle" fill="var(--text)" font-size="18">
            Orbit Radar · {pt ? "Dados → órbitas → visualização" : "Data → orbits → visualisation"}
          </text>
        </>
      </svg>
    ) : (
      <svg viewBox="0 0 600 400" role="img" aria-label={labels.join(" → ")}>
        <text x="45" y="65" fill="var(--muted)" font-size="14">
          {pt ? "ESTRUTURA DO PROJETO" : "PROJECT OVERVIEW"}
        </text>
        {labels.map((label, i) => (
          <g>
            <rect
              x={45 + i * 177}
              y="157"
              width="155"
              height="76"
              rx="8"
              fill="var(--surface)"
              stroke="var(--line)"
            />
            <text x={122 + i * 177} y="200" text-anchor="middle" fill="var(--text)" font-size="15">
              {label}
            </text>
            {i < 2 && (
              <text x={204 + i * 177} y="201" fill="var(--accent)" font-size="21">
                →
              </text>
            )}
          </g>
        ))}
        <text x="45" y="340" fill="var(--accent)" font-size="16">
          {kind === "xcos-mcp"
            ? "Inspect · build · validate · simulate"
            : "C++ · mixed low-precision arithmetic"}
        </text>
      </svg>
    )
  }
</div>
<style>
  .diagram {
    display: grid;
    place-items: center;
  }
  svg {
    width: 100%;
    height: 100%;
    font-family: ui-monospace, monospace;
  }
  .demo-card {
    margin: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 1.25rem;
    max-width: 28rem;
    background: var(--bg);
  }
  .demo-kicker,
  .demo-card span {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .demo-card .demo-symbol {
    font-size: 2rem;
    color: var(--accent);
  }
  .demo-card h4 {
    font-size: 1.3rem;
    margin: 0.2rem 0 0.7rem;
  }
  .demo-card p {
    font-size: 0.9rem;
    margin-bottom: 0.7rem;
  }
  .diagram:has(.demo-card) {
    aspect-ratio: auto;
    min-height: 20rem;
  }
</style>
