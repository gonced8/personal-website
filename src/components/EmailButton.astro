---
const { label = "Email me" } = Astro.props;
---

<button class="email-button" type="button">{label}</button>
<script>
  document.querySelector<HTMLButtonElement>(".email-button")?.addEventListener("click", (event) => {
    const codes = [103, 111, 110, 99, 101, 100, 56, 64, 103, 109, 97, 105, 108, 46, 99, 111, 109];
    const address = String.fromCharCode(...codes);
    const button = event.currentTarget as HTMLButtonElement;
    button.textContent = address;
    button.setAttribute("aria-label", `Email ${address}`);
    window.location.href = `mailto:${address}`;
  });
</script>
